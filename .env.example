GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Nomor yang boleh mendapat balasan: kode negara + nomor, hanya angka.
# Contoh: 6281234567890
ALLOWED_NUMBER=

DATA_DIR=./data
CONNECTION_ONLY=true
LOG_LEVEL=silent

# Chat duluan: jadwal tetap + setelah 2-4 jam sepi + waktu acak.
PROACTIVE_ENABLED=true
PROACTIVE_TIMES=08:00,12:30,19:30
PROACTIVE_DAILY_MAX=5
